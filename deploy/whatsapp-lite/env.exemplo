# Modelo do .env do conector do WhatsApp Lite. O instalar-evolution.sh cria o .env com senhas e chave aleatórias.
# Nomes das variáveis conforme o .env.example oficial da Evolution API v2.

# Domínio do conector (registro A apontando para o IP da VPS)
DOMINIO=whatsapp.veroconsorciosbr.com.br

# Servidor
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://whatsapp.veroconsorciosbr.com.br

# Chave global: a mesma que vai no CRM (Integrações › WhatsApp Lite › Servidor)
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Banco (Postgres do próprio docker-compose)
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-por-uma-senha-aleatoria@postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Cache (Redis do próprio docker-compose)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Sessão no celular (aparece em "Aparelhos conectados")
CONFIG_SESSION_PHONE_CLIENT=Vero CRM
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false

# O CRM cadastra o webhook de cada número sozinho: não use webhook global
WEBHOOK_GLOBAL_ENABLED=false

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
TELEMETRY_ENABLED=false
