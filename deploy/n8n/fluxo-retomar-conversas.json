    {
      "parameters": {
        "jsCode": "// Uma chamada ao atendimento por conversa devolvida (até 3 por minuto)\nconst n = Math.min(3, Number($json.pendentes) || 0);\nreturn Array.from({ length: n }, () => ({ json: { retomar: true } }));"
