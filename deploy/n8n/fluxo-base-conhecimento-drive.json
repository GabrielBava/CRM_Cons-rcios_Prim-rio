        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "19301f94-87cd-409b-aa49-0b72702d71b1",
      "name": "Arquivo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DO $$ BEGIN IF to_regclass('public.vero_conhecimento') IS NOT NULL THEN DELETE FROM vero_conhecimento WHERE metadata->>'documento' = 'drive-{{ String($json.id).replace(/[^A-Za-z0-9_-]/g, '') }}'; END IF; END $$;",
        "options": {}
      },
      "id": "eb17b3b4-f049-4171-a718-10927da85db1",
      "name": "Apagar a versão anterior",
      "type": "n8n-nodes-base.postgres",
