      "position": [
        40,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "VeroPostgres0001",
          "name": "Postgres da VPS (base de conhecimento)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $('Arquivo').item.json.id }}",
