          "whatToSearch": "files",
          "includeTrashed": false
        },
        "options": {
          "fields": [
            "*"
          ]
        }
      },
      "id": "96d7eae8-0f66-4474-a41d-ab8735a23809",
      "name": "Arquivos da pasta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        0,
        80
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "VeroGDrive000001",
          "name": "Google Drive (Vero)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT metadata->>'documento' AS documento, max(metadata->>'modificado') AS modificado FROM vero_conhecimento WHERE metadata->>'fonte' = 'drive' GROUP BY 1",
        "options": {}
      },
      "id": "ffa85b4c-eb69-46b2-af13-eae427097809",
      "name": "Já na base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "VeroPostgres0001",
          "name": "Postgres da VPS (base de conhecimento)"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Compara a pasta com a base: arquivo novo ou alterado entra; arquivo que saiu da pasta é apagado da base\nconst LIDOS = /^(application\\/vnd\\.google-apps\\.(document|spreadsheet|presentation)|application\\/pdf|application\\/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|application\\/epub\\+zip|application\\/json|text\\/.+)$/;\nconst naBase = new Map($('Já na base').all().filter((i) => i.json.documento).map((i) => [i.json.documento, i.json.modificado]));\nconst arquivos = $('Arquivos da pasta').all().map((i) => i.json).filter((f) => f.id && LIDOS.test(f.mimeType || ''));\nconst naPasta = new Set(arquivos.map((f) => 'drive-' + f.id));\nconst saida = [];\nfor (const f of arquivos) {\n  const documento = 'drive-' + f.id;\n  if (naBase.get(documento) !== f.modifiedTime) saida.push({ json: { acao: 'importar', id: f.id, nome: f.name, modificado: f.modifiedTime, documento } });\n}\nfor (const documento of naBase.keys()) if (!naPasta.has(documento)) saida.push({ json: { acao: 'remover', documento } });\nreturn saida;"
      },
      "id": "e9fbf760-9012-4086-aa09-9e071b4bd8e2",
      "name": "O que mudou",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=DELETE FROM vero_conhecimento WHERE metadata->>'fonte' = 'drive' AND metadata->>'documento' IN ({{ $('O que mudou').all().map((i) => \"'\" + String(i.json.documento).replace(/[^A-Za-z0-9_-]/g, '') + \"'\").join(', ') || \"''\" }})",
        "options": {}
      },
      "id": "bf284aac-b697-4caf-a886-c273017d1f9c",
      "name": "Apagar versões antigas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        80
      ],
      "credentials": {
