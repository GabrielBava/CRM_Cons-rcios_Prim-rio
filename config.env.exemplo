# Configuração local do Vero Consórcios. Copie este arquivo para "config.env" (na mesma pasta) e preencha.
# O config.env guarda senhas: não envie para o GitHub (ele já está no .gitignore).

# Google Agenda + Google Meet (R1). Google Cloud › APIs e serviços › Credenciais › ID do cliente OAuth (Aplicativo da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails automáticos (ficha cadastral e R1 agendada)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=noreply@veroconsorciosbr.com.br
SMTP_PASSWORD=
SMTP_FROM=noreply@veroconsorciosbr.com.br
SMTP_FROM_NAME=Vero Consórcios

# WhatsApp da empresa (API oficial do WhatsApp Business / Cloud API da Meta). Veja docs/INTEGRACOES.md, seção 10.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# WhatsApp Lite (número do especialista por QR Code), servidor compatível com a Evolution API v2. Veja docs/INTEGRACOES.md, seção 18.
# Também pode ser configurado pela tela (Integrações › WhatsApp Lite), pelo administrador.
# EVOLUTION_API_URL=https://seu-servidor-evolution
# EVOLUTION_API_KEY=
# Tamanho máximo de cada arquivo enviado pelo WhatsApp, em MB (padrão 3, por causa do limite da Vercel)
# WA_MAX_FILE_MB=3

# Endereço público do CRM (produção, com HTTPS). Em teste local deixe vazio.
# No servidor, o instalador já define com: sudo DOMINIO=crm.veroconsorciosbr.com.br bash deploy/instalar-ubuntu.sh
# PUBLIC_URL=https://crm.veroconsorciosbr.com.br

# Banco no Supabase (Postgres) — usado na Vercel. Sem DATABASE_URL, o CRM usa o arquivo SQLite (CRM_DB).
# Supabase › Connect › Session pooler (porta 5432): postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DATABASE_URL=
# Chave que cifra os segredos guardados (gere uma vez e não troque): openssl rand -base64 32
# CRM_SECRET_KEY=
# Vercel: segredo do agendamento diário (/api/cron) e versão de teste com dados de demonstração
# CRON_SECRET=
# CRM_DEMO=1
# DEMO_PASSWORD=

# Supabase (cópia de teste do banco: npm run supabase -- --enviar). Token em supabase.com › Account › Access Tokens.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# IA Vero — IA generativa opcional nas perguntas livres do chat do painel do lead (Claude, da Anthropic).
# Requer também a biblioteca no servidor: npm install @anthropic-ai/sdk. Ligue em Configurações › Integrações › IA Vero.
# ANTHROPIC_API_KEY=
