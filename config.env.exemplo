# Configuração local do Vero Consórcios. Copie este arquivo para "config.env" (na mesma pasta) e preencha.
# O config.env guarda senhas: não envie para o GitHub (ele já está no .gitignore).

# Google Agenda + Google Meet (R1). Google Cloud › APIs e serviços › Credenciais › ID do cliente OAuth (Aplicativo da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails automáticos (ficha cadastral e R1 agendada)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=noreply@veroconsorciosbr.com.br
SMTP_PASSWORD=
SMTP_FROM=noreply@veroconsorciosbr.com.br
SMTP_FROM_NAME=Vero Consórcios

# Endereço público do CRM (produção, com HTTPS). Em teste local deixe vazio.
# PUBLIC_URL=https://crm.veroconsorciosbr.com.br
